# Methode recommandee : reutilise la session Instagram deja active dans un
# navigateur ou tu es deja connecte normalement (evite le "checkpoint" de
# verification qu'Instagram declenche souvent sur un login scripte).
# Valeurs possibles : chrome, firefox, edge, safari, brave, chromium, opera,
# opera_gx, vivaldi, librewolf
IG_COOKIES_BROWSER=

# Methode alternative : login classique par identifiants (laisser vide si
# IG_COOKIES_BROWSER est renseigne).
IG_USERNAME=
IG_PASSWORD=
